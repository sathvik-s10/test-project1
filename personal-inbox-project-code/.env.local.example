# Copy this file to .env.local and fill in your own Supabase project values.
# Get these from https://supabase.com/dashboard/project/_/settings/api

# Public - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret - server-side only, NEVER prefix with NEXT_PUBLIC_, never commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for building email-confirmation redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of emails that should have admin (owner) permissions.
# Anyone signing in with one of these verified emails gets access to /admin.
ADMIN_EMAILS=owner@example.com
